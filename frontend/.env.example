# Origin of the DepositGuard backend API (no trailing slash).
# Local development leaves this unset and defaults to http://localhost:8000
#
# For a deployed frontend, set this in your host's environment variables to the
# public URL of your backend, e.g.
#   VITE_API_BASE_URL=https://depositguard-api.onrender.com
VITE_API_BASE_URL=http://localhost:8000
